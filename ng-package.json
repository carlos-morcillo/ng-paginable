{
	"$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
	"dest": "../../dist/paginable",
	"lib": {
		"entryFile": "src/public-api.ts",
		"styleIncludePaths": ["src/lib/styles"]
	},
	"assets": [
		{
			"input": "src/lib/styles",
			"glob": "**/*",
			"output": "styles"
		},
		{
			"input": "docs",
			"glob": "css-variables-reference*.md",
			"output": "docs"
		}
	]
}
